DATABASE_URL=postgresql://sppadmin:CHANGEME@localhost:15432/s3p
REDIS_URL=redis://:CHANGEME@localhost:6379/0
REDIS_PASSWORD=CHANGEME
SESSION_SECRET=replace-with-32+chars-of-random-data-XXXXXXXX
SESSION_COOKIE_SECURE=true
# Set to "none" when the SPA is on a different domain than the api
# (cross-site cookies). "lax" is correct for same-origin deploys.
# SESSION_COOKIE_SAMESITE=none
# JSON array. Leave unset for same-origin deploys; populate when the
# SPA is on a different domain than the api.
# CORS_ALLOW_ORIGINS=["https://score.s3platform.ru"]
LOG_LEVEL=INFO
WORKER_INTERVAL_SECONDS=60
